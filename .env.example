# ---------------------------------------------------------------- Aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------- Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO servidor. Nunca exponer en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- Wompi (comercios.wompi.co → Desarrolladores)
# sandbox | production
WOMPI_ENV=sandbox
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
# SOLO servidor
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# ---------------------------------------------------------------- Correo transaccional (Resend)
RESEND_API_KEY=
EMAIL_FROM="Médico en Casa Palmira <notificaciones@tu-dominio.co>"

# ---------------------------------------------------------------- Procesos programados
# Secreto compartido para /api/cron/* (Vercel Cron lo envía como Authorization: Bearer)
CRON_SECRET=
